# =================================================================
# Jobseeker Hub - Plik konfiguracyjny środowiska (Przykładowy)
# Skopiuj ten plik jako .env.local i uzupełnij danymi z panelu Supabase
# =================================================================

# URL Twojego projektu w Supabase (np. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co

# Nowy Publishable key (sb_publishable_...) lub legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_twoj_klucz_tutaj
# Alternatywnie akceptowana jest też tradycyjna nazwa:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_twoj_klucz_tutaj
